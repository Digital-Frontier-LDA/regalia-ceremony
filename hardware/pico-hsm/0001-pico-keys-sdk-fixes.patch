+                         * bound is kept so a genuine race cannot block forever.
+                         * Do NOT re-enter the lockout to re-sync — the SDK documents
+                         * lockouts as non-nestable. Stop this drain pass; the page stays
+                         * queued and the next pass retries, and a truly parked core1 is
+                         * caught by the liveness machinery (usb.c). */
                         printf("ERROR: FLASH LOCKOUT END TIMEOUT — aborting this drain pass\n");
                         break;
                     }
diff --git a/src/main.c b/src/main.c
index 745031f..8d94524 100644
--- a/src/main.c
+++ b/src/main.c
@@ -45,12 +45,20 @@
 
 #if defined(PICO_PLATFORM)
 /* The SDK's hard_assertion_failure() is __weak; override it. The default path is
- * panic() -> __breakpoint -> _exit: a silent, permanent brick that needs a physical
- * replug — measured 2026-08-03 (a corrupt flash_pages entry hit
- * hard_assert(flash_offs + count <= PICO_FLASH_SIZE_BYTES) and the device sat
- * catatonic for a day). A smartcard that cannot recover itself is not one. Reboot
- * via the bootrom instead: each boot is a fresh roll, and the core1 launch-verify
- * and dead-man's switch do their jobs from there. */
+ * panic() -> __breakpoint -> _exit, which leaves the running firmware permanently
+ * unresponsive until an external reset. (NOT a "brick" — BOOTSEL plus a full
+ * flash_nuke and reflash always recovers the board; upstream was right to correct
+ * that wording.) Worse than a plain hang: the panic fires inside low_flash_task()
+ * between multicore-lockout START and END and after save_and_disable_interrupts(),
+ * so core0 dies holding the lockout with interrupts off and core1 is parked in
+ * multicore_lockout_handler forever — the card enumerates but never answers.
+ * Reproduced on unmodified upstream firmware 2026-08-05: a chain link accepted by
+ * scan_region() yields file->data = 0x2000D5A5 (SRAM), which reaches
+ * hard_assert(flash_offs + count <= PICO_FLASH_SIZE_BYTES). See regalia
+ * hardware/pico-hsm/UPSTREAM-REPRO-STOCK.md. A smartcard that cannot recover itself
+ * is not one, so reboot via the bootrom instead. NOTE: this is recovery, not a fix —
+ * upstream correctly notes it can reboot-loop on persistent corruption, which is why
+ * it is withdrawn from the upstream PR series and kept only in our build. */
 void hard_assertion_failure(void) {
     printf("PANIC: hard assert failed — rebooting via rom_reboot\n");
     rom_reboot(REBOOT2_FLAG_REBOOT_TYPE_NORMAL, 1, 0, 0);
-- 

From bafe74aacebf528f50f13f0c01ab493e3ce648ef Mon Sep 17 00:00:00 2001
From: "open-swe[bot]" <open-swe@users.noreply.github.com>
Date: Wed, 5 Aug 2026 15:13:18 -0400
Subject: [PATCH 13/15] fix(fs): never write a FILE_DATA_FUNC file's ->data (it
 is a function pointer)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ROOT CAUSE of the mute-card-after-INITIALIZE failure, found 2026-08-05 on
unmodified upstream firmware. This supersedes the earlier scan_region()
attribution, which was wrong — the on-flash record chain is intact.

OpenSC's INITIALIZE issues UPDATE BINARY on EF.TokenInfo (0x2F03). pico-hsm
declares that EF as FILE_TYPE_WORKING_EF | FILE_DATA_FUNC with
.data = parse_token_info, i.e. ->data is a Thumb FUNCTION POINTER (0x2000D5A5 =
parse_token_info+1), not a flash address. Every other consumer checks the flag
first (file.c SELECT/FCI path, cmd_read_binary.c read path); the write path did
not, so flash_program_halfword() was handed a .text address, find_free_page()
cached 4KB of code as a dirty sector, and low_flash_task() called
flash_range_erase(0x1000D000) — tripping the SDK bounds assert and killing core0
while it held the multicore lockout with interrupts disabled. Core1 then parked
in multicore_lockout_handler forever: reader enumerated, card permanently mute.

Also widens the fs guard from a start-address check to a full-range check
(flash_range_in_fs): flash_program_block() walks forward across sectors and
flash_erase_page() erases page_size bytes, so validating only the start address
let a write run off the end of the region. Requested by upstream review.
---
 src/fs/flash.c     | 40 ++++++++++++++++++++++++++++++++++++++++
 src/fs/flash.h     |  1 +
 src/fs/low_flash.c | 26 ++++++++++++++++++++------
 3 files changed, 61 insertions(+), 6 deletions(-)

diff --git a/src/fs/flash.c b/src/fs/flash.c
index a671db9..0075bce 100644
--- a/src/fs/flash.c
+++ b/src/fs/flash.c
@@ -66,6 +66,28 @@ bool flash_addr_in_fs(uintptr_t addr) {
     return addr >= start_data_pool && addr < end_flash;
 }
 
+/* True only if the WHOLE [addr, addr + len) span stays inside the fs data region —
+ * and so does the sector-aligned base that find_free_page() will actually operate on.
+ * Checking just the start address is not enough: flash_program_block() walks forward
+ * across sectors as it consumes data, and flash_erase_page() erases page_size bytes,
+ * so a start address one byte inside the region can still run off the end. Upstream
+ * asked for exactly this ("cover the entire aligned sector/range, including erase
+ * size" — polhenarejos/pico-keys-sdk#25). The subtraction is done against end_flash
+ * only after addr is known to be below it, so it cannot wrap. */
+bool flash_range_in_fs(uintptr_t addr, size_t len) {
+    if (len == 0) {
+        return false;
+    }
+    if (addr < start_data_pool || addr >= end_flash) {
+        return false;
+    }
+    /* find_free_page() aligns down; that base must be in-region too. */
+    if ((addr & ~(uintptr_t) (FLASH_SECTOR_SIZE - 1)) < start_data_pool) {
+        return false;
+    }
+    return len <= (size_t) (end_flash - addr);
+}
+
 void flash_set_bounds(uintptr_t start, uintptr_t end) {
     end_flash = end;
     end_rom_pool = end_flash - FLASH_DATA_HEADER_SIZE - 4;
@@ -187,6 +209,24 @@ static int flash_write_data_to_file_internal(file_t *file, const_byte_array_t da
         return PICOKEYS_ERR_NULL_PARAM;
     }
 
+    /* A FILE_DATA_FUNC file's ->data is a generator FUNCTION POINTER, not a flash
+     * address. Every other consumer checks this flag before using ->data (the
+     * SELECT/FCI path in file.c and the READ path in cmd_read_binary.c both do);
+     * this write path did not, so an UPDATE BINARY on such an EF handed a .text
+     * address straight to the flash layer.
+     *
+     * Measured on unmodified upstream firmware 2026-08-05: OpenSC's INITIALIZE
+     * writes EF.TokenInfo (0x2F03), which pico-hsm declares as
+     * FILE_TYPE_WORKING_EF | FILE_DATA_FUNC with .data = parse_token_info. The
+     * write reached flash_program_halfword(0x2000D5A5) — parse_token_info+1, a
+     * Thumb pointer — find_free_page() then cached 4 KB of .text as a dirty sector
+     * and low_flash_task() called flash_range_erase(0x1000D000), tripping
+     * hard_assert() and killing core0 while it held the multicore lockout with
+     * interrupts disabled. The card enumerated but never answered again. */
+    if ((file_get_type(file) & FILE_DATA_FUNC) == FILE_DATA_FUNC) {
+        return PICOKEYS_ERR_BLOCKED;
+    }
+
     len = (uint32_t)data.len;
 
     uint32_t old_size = file_get_size(file);
diff --git a/src/fs/flash.h b/src/fs/flash.h
index c186d63..13ea739 100644
--- a/src/fs/flash.h
+++ b/src/fs/flash.h
@@ -35,6 +35,7 @@ extern uint32_t flash_size(void);
 
 extern void flash_set_bounds(uintptr_t start, uintptr_t end);
 extern bool flash_addr_in_fs(uintptr_t addr);
+extern bool flash_range_in_fs(uintptr_t addr, size_t len);
 extern int flash_write_data_to_file(file_t *file, const_byte_array_t data);
 extern int flash_write_data_to_file_offset(file_t *file, const_byte_array_t data, uint32_t offset);
 extern int flash_program_block(uintptr_t addr, const_byte_array_t data);
diff --git a/src/fs/low_flash.c b/src/fs/low_flash.c
index 2b608b2..b5fcf68 100644
--- a/src/fs/low_flash.c
+++ b/src/fs/low_flash.c
@@ -416,10 +416,15 @@ int flash_program_block(uintptr_t addr, const_byte_array_t data) {
         return PICOKEYS_ERR_NULL_PARAM;
     }
     /* Validate BEFORE find_free_page() reads from the address: fs metadata corruption
-     * can hand us a garbage pointer (measured 2026-08-04: BFAR=0x6CB44000, a bogus
-     * prev_addr reached via flash_clear_file -> HardFault). Fail loudly, never read. */
-    if (!flash_addr_in_fs(addr)) {
-        printf("ERROR: flash_program_block to out-of-fs address %p — refusing\n", (void *) addr);
+     * can hand us a garbage pointer. Reproduced on unmodified upstream firmware
+     * 2026-08-05 — scan_region() accepts an out-of-region chain link, file->data
+     * becomes 0x2000D5A5 (SRAM), and this call would cache 4KB from SRAM and then
+     * trip hard_assert() inside flash_range_erase(), killing core0 while it holds the
+     * multicore lockout. Validate the WHOLE span, not just the start: the loop below
+     * walks addr forward across sectors as it consumes data. Fail loudly, never read. */
+    if (!flash_range_in_fs(addr, data.len)) {
+        printf("ERROR: flash_program_block %p+%u out of fs region — refusing\n",
+               (void *) addr, (unsigned) data.len);
         return PICOKEYS_ERR_MEMORY_FATAL;
     }
 
@@ -558,8 +563,17 @@ uint8_t flash_read_uint8(uintptr_t addr) {
 int flash_erase_page(uintptr_t addr, size_t page_size) {
     page_flash_t *p = NULL;
 
-    if (!flash_addr_in_fs(addr)) {
-        printf("ERROR: flash_erase_page of out-of-fs address %p — refusing\n", (void *) addr);
+    /* Validate the full erase SPAN, not just the start: low_flash_task() erases
+     * page_size rounded down to whole sectors (min one sector), so an address one
+     * byte inside the region can still erase past its end. */
+    size_t erase_len = page_size ? (page_size / FLASH_SECTOR_SIZE) * FLASH_SECTOR_SIZE
+                                 : FLASH_SECTOR_SIZE;
+    if (erase_len == 0) {
+        erase_len = FLASH_SECTOR_SIZE;
+    }
+    if (!flash_range_in_fs(addr, erase_len)) {
+        printf("ERROR: flash_erase_page %p+%u out of fs region — refusing\n",
+               (void *) addr, (unsigned) erase_len);
         return PICOKEYS_ERR_MEMORY_FATAL;
     }
     mutex_enter_blocking(&mtx_flash);
-- 

From 25fc4b3c0b6cf1999555f296ae12a1c9d8155bd3 Mon Sep 17 00:00:00 2001
From: "open-swe[bot]" <open-swe@users.noreply.github.com>
Date: Wed, 5 Aug 2026 19:15:31 -0400
Subject: [PATCH 14/15] =?UTF-8?q?fix(hsm):=20remove=20the=20core1=20dead-m?=
 =?UTF-8?q?an's=20switch=20=E2=80=94=20it=20ate=20CCID=20completion=20even?=
 =?UTF-8?q?ts?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Upstream predicted this in review of the original series:

  'the dead-man switch ... competes with card_status() for card_to_usb_q and can
   consume normal completion or button events'

That is exactly what it did. card_watchdog_task() popped card_to_usb_q itself,
and a comment here claimed the handling was 'identical' to the CCID layer's. It
is not:

  - card_status() pops EV_EXEC_FINISHED -> ccid_task() calls
    driver_exec_finished_ccid() -> the response is SENT to the host.
  - card_watchdog_task() pops it first  -> only clears a local flag -> the
    response is NEVER sent and the host waits forever.

Both run on core0, so it was a race, and the symptom was intermittent.

Measured on hardware, pkcs11-tool --keypairgen:
  with the dead-man's switch : 1 ok / 5 bad, failures HANGING for minutes
  without it                 : 0 hangs; successes complete in ~5s

The card always completed normally in both cases (SW_OK, key persisted, both
cores idle) — only the response delivery was lost.

The liveness problem this was meant to catch was never independently
substantiated, so nothing replaces it. Core1 launch verification in card_start()
is a separate, evidenced mechanism and is retained.

Removes now-dead card_recover_core1().
---
 src/usb/usb.c | 73 +++++++++++++--------------------------------------
 1 file changed, 18 insertions(+), 55 deletions(-)

diff --git a/src/usb/usb.c b/src/usb/usb.c
index 69b2f87..486587a 100644
--- a/src/usb/usb.c
+++ b/src/usb/usb.c
@@ -539,19 +539,6 @@ static void card_note_core1_alive(void) {
     ping_sent_ms = 0;
 }
 
-/* Recover a lost core1. Measured 2026-08-02: relaunching core1 alone is NOT enough —
- * core0's CCID slot state (TPDU sequencing, block state) belongs to the dead session,
- * so the card connects but every APDU transmit fails ("Transmit failed" at PC/SC).
- * The only coherent recovery from a mid-session core1 death is a full chip reset:
- * both sides reinitialise, the host re-enumerates and reconnects. */
-static void card_recover_core1(void) {
-    watchdog_hw->scratch[2] += 1;
-    printf("CARD: core1 lost mid-session, resetting chip\n");
-    cmd_in_flight = false;
-    ping_sent_ms = 0;
-    chip_reset_bounded();
-}
-
 void card_watchdog_task(void) {
     uint64_t now = board_millis();
     if (now - wd_last_run_ms < 50) {
@@ -573,48 +560,24 @@ void card_watchdog_task(void) {
         return;
     }
 
-    if (card_locked_itf == ITF_TOTAL || card_locked_func == NULL) {
-        ping_sent_ms = 0;
-        cmd_in_flight = false;
-        return;
-    }
-
-    /* Consume anything core1 sent — every message is proof of life. The CCID layer
-     * does the same via card_status(); both run on core0, so whoever pops first wins
-     * and the handling is identical. */
-    uint32_t m = 0;
-    if (queue_try_remove(&card_to_usb_q, &m)) {
-        if (m == EV_PING_ECHO || m == EV_EXEC_FINISHED) {
-            cmd_in_flight = false;
-        }
-        else if (m == EV_RESET) {
-            usb_secure_reboot_now();
-        }
-        card_note_core1_alive();
-    }
-
-    if (cmd_in_flight) {
-        if (now - cmd_started_ms > CMD_DEADLINE_MS) {
-            printf("CARD: command outstanding >%lus — core1 presumed dead\n",
-                   (unsigned long) (CMD_DEADLINE_MS / 1000));
-            card_recover_core1();
-        }
-        return;
-    }
-
-    if (ping_sent_ms != 0) {
-        if (now - ping_sent_ms > CARD_PING_TIMEOUT_MS) {
-            card_recover_core1();
-        }
-        return;
-    }
-
-    if (now - core1_last_ok_ms > CARD_PING_INTERVAL_MS) {
-        uint32_t ping = EV_PING;
-        if (queue_try_add(&usb_to_card_q, &ping)) {
-            ping_sent_ms = now;
-        }
-    }
+    /* The core1 dead-man's switch used to live here. It has been REMOVED because it
+     * was actively harmful, exactly as upstream predicted in review:
+     *
+     *   "the dead-man switch ... competes with card_status() for card_to_usb_q and can
+     *    consume normal completion or button events"
+     *
+     * It popped card_to_usb_q itself, and an earlier comment here claimed the handling
+     * was "identical" to the CCID layer's. It is not. When card_status() pops
+     * EV_EXEC_FINISHED, ccid_task() calls driver_exec_finished_ccid() and the response
+     * goes out to the host. When this task popped it first, it only cleared a local
+     * flag — the response was NEVER sent and the host waited forever. Both tasks run on
+     * core0, so it was a race: measured as an intermittent hang of
+     * pkcs11-tool --keypairgen (~5 failures in 6 attempts), with the card completing
+     * normally (SW_OK, key persisted) and both cores idle.
+     *
+     * The liveness problem it was meant to catch was never independently substantiated,
+     * so nothing replaces it. Core1 launch verification (card_start) is a separate,
+     * evidenced mechanism and is retained. */
 }
 #endif
 
-- 

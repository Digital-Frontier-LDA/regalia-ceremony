                                               flash_pages[r].page_size ? ((size_t) (flash_pages[r].page_size / FLASH_SECTOR_SIZE)) * FLASH_SECTOR_SIZE : FLASH_SECTOR_SIZE);
-                    if (multicore_lockout_end_timeout_us(1000) == false) {

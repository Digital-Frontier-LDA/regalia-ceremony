#!/usr/bin/env bash
# pkcs11-tool shim — transparently routes the ceremony's unmodified pkcs11-tool calls to
# the SoftHSM2 token (our Nitrokey HSM 2 stand-in) instead of a physical OpenSC card.
#
# It injects `--module $EMU_PKCS11_MODULE` when the caller didn't pick a module, and an
# off-argv `--pin env:EMU_HSM_PIN` for login operations during automated tests (when
# EMU_HSM_PIN is set and no --pin was given) so the PIN value stays out of the child's
# command line, then forwards to the real OpenSC pkcs11-tool.
#
# SoftHSM2 runs REAL crypto: secp256k1 keygen, ECDSA signing, and pubkey DER export all
# behave as on the card (the one documented difference is ECDSA's random k, so a given
# message's signature isn't byte-identical run to run — verification is what matters).
#
# TWO-DEVICE MODEL: SoftHSM2 is one shared token, but the ceremony drives two cards (primary +
# clone target). Each card is modelled by its own $EMU_SCHSM_STATE directory, and when that
# directory exists its `objects` registry — not the shared token — decides what the card holds.
# Pubkey reads for a restored key are pinned to the key-reference sc-hsm-tool actually unwrapped
# into, so a clone target can never answer with the primary card's key.
set -euo pipefail

# ==================================================================================================
# THE OPERATION-PROOF TOKEN MODEL (regalia#28 criterion 3). operation-proof.sh signs a challenge with
# pkcs11-tool on a YubiKey (through Yubico's ykcs11 module) or a Nitrokey (through opensc-pkcs11).
# Neither has a SoftHSM stand-in that knows about per-serial YubiKeys, so this branch IS the token,
# with real openssl keys, and it is taken BEFORE the real binary is even looked up — nothing in it can
# fall through to OpenSC and reach whatever card is attached to the machine running the tests.
#
#   --module …/libykcs11*   the YubiKeys the ykman shim generated: $EMU_YKMAN_STATE/<serial>/<slot>/,
#                           addressed by ykcs11's fixed ids (9a=01 9c=02 9d=03 9e=04 82..95=05..18)
#   EMU_P11_TOKENS=DIR      any other module: $EMU_P11_TOKENS/<serial>/<id>/, one dir per card
#
# PIN: default 123456 (YubiKey) / 648219 (Nitrokey), or <token>/pin. Three tries, tracked in
# <token>/pin-tries; a wrong PIN spends one (CKR_PIN_INCORRECT), none left is CKR_PIN_LOCKED.
# THE PIN MUST ARRIVE AS `--pin env:NAME`: a literal PIN on the command line is refused with a loud
# error, so a regression that puts it on argv fails the suites instead of passing quietly.
# ECDSA output is raw r||s unless --signature-format openssl, as in OpenSC — so dropping that flag
# breaks verification here exactly as it would against a card.
# --decrypt RSA-PKCS-OAEP honours --hash-algorithm / --mgf (default SHA-1, as OpenSC), so a ciphertext
# made with other OAEP parameters fails here as on a card. --derive ECDH1-DERIVE takes the peer's SPKI.
# EMU_P11_BAD_SIGNATURE=1 (or EMU_P11_BAD_RESULT=1) makes the token return a well-formed but WRONG
# answer: a signature over other data, a decryption with a flipped byte, a shared secret with one.
# EMU_P11_ARGV_LOG=FILE appends every argv this model sees, for the secret-leak suite.
# ==================================================================================================
emu_module=""; _prev=""
for _a in "$@"; do [ "$_prev" = "--module" ] && emu_module="$_a"; _prev="$_a"; done
emu_model=""
case "${emu_module##*/}" in libykcs11*) emu_model=ykcs11;; esac
[ -z "$emu_model" ] && [ -n "${EMU_P11_TOKENS:-}" ] && emu_model=tokens

emu_p11(){
  [ -n "${EMU_P11_ARGV_LOG:-}" ] && printf '%s\n' "$*" >> "$EMU_P11_ARGV_LOG"
  local root pin_default list=0 keygen=0 read_obj=0 sign=0 login=0 slot="" id="" out="" in="" mech="" keytype=""
  local pin_arg="" fmt="" type="" decrypt=0 derive=0 oaep_hash=SHA-1 mgf=""
  if [ "$emu_model" = ykcs11 ]; then root="${EMU_YKMAN_STATE:-${TMPDIR:-/tmp}/emu-ykman}"; pin_default=123456
  else root="$EMU_P11_TOKENS"; pin_default=648219; fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --module) shift 2;;
      -L|--list-slots|-T|--list-token-slots) list=1; shift;;
      --keypairgen|-k) keygen=1; shift;;
      --read-object|-r) read_obj=1; shift;;
      --sign|-s) sign=1; shift;;
      --decrypt) decrypt=1; shift;;
      --derive) derive=1; shift;;
      --hash-algorithm) oaep_hash="$2"; shift 2;;
      --mgf) mgf="$2"; shift 2;;
      --login|-l) login=1; shift;;
      --slot) slot="$2"; shift 2;;
      --id|-d) id="$(printf '%s' "$2" | tr 'A-F' 'a-f')"; shift 2;;
      --output-file|-o) out="$2"; shift 2;;
      --input-file|-i) in="$2"; shift 2;;
      --mechanism|-m) mech="$2"; shift 2;;
      --key-type) keytype="$2"; shift 2;;
      --type|-y) type="$2"; shift 2;;
      --signature-format) fmt="$2"; shift 2;;
      --pin|-p) pin_arg="$2"; shift 2;;
      --label|-a) shift 2;;
      *) echo "pkcs11-tool [EMULATED $emu_model]: unsupported argument $1" >&2; return 2;;
    esac
  done
  local serials=() s
  if [ -d "$root" ]; then
    for s in "$root"/*/; do [ -d "$s" ] && serials+=("$(basename "$s")"); done
  fi
  # Slot ids step by 4 for the card model, the way OpenSC numbers readers (0x0, 0x4, …), so a caller
  # that confuses a slot's POSITION with its ID addresses the wrong token here as it would on the bench.
  local step=1; [ "$emu_model" = tokens ] && step=4
  if [ "$list" = 1 ]; then
    echo "Available slots:"
    local i=0
    for s in ${serials[@]+"${serials[@]}"}; do
      if [ "$emu_model" = ykcs11 ]; then
        printf 'Slot %d (0x%x): Yubico YubiKey OTP+FIDO+CCID 00 00\n  token label        : YubiKey PIV #%s\n' $((i*step)) $((i*step)) "$s"
        printf '  token manufacturer : Yubico (www.yubico.com)\n  token model        : YubiKey YK5\n'
      else
        printf 'Slot %d (0x%x): Nitrokey Nitrokey HSM (%s) 00 00\n  token label        : SmartCard-HSM (UserPIN)\n' $((i*step)) $((i*step)) "$s"
        printf '  token manufacturer : www.CardContact.de\n  token model        : PKCS#15 emulated\n'
      fi
      printf '  serial num         : %s\n' "$s"
      i=$((i+1))
    done
    return 0
  fi
  # Resolve the token: --slot by ID, or the only one present.
  local tok=""
  if [ -n "$slot" ]; then
    local want=$((slot)) i=0
    for s in ${serials[@]+"${serials[@]}"}; do [ $((i*step)) -eq "$want" ] && tok="$s"; i=$((i+1)); done
  elif [ "${#serials[@]}" -eq 1 ]; then tok="${serials[0]}"
  fi
  [ -n "$tok" ] || { echo "error: no token in slot '${slot:-<none>}' [EMULATED]" >&2; echo "Aborting." >&2; return 1; }
  local tdir="$root/$tok" kdir
  if [ "$emu_model" = ykcs11 ]; then
    case "$id" in
      01) kdir="$tdir/9a";; 02) kdir="$tdir/9c";; 03) kdir="$tdir/9d";; 04) kdir="$tdir/9e";;
      0[5-9]|1[0-8]|0[a-f]) kdir="$tdir/$(printf '%02x' $(( 16#$id - 5 + 16#82 )))";;
      *) kdir="$tdir/none-$id";;
    esac
  else
    kdir="$tdir/$id"
  fi
  if [ "$login" = 1 ]; then
    case "$pin_arg" in
      env:?*) ;;
      "") echo "pkcs11-tool [EMULATED]: --login without --pin would prompt; the ceremony must pass env:NAME" >&2; return 2;;
      *) echo "pkcs11-tool [EMULATED]: A LITERAL PIN IS ON THE COMMAND LINE — refused; pass --pin env:NAME" >&2; return 3;;
    esac
    local var="${pin_arg#env:}" want_pin tries
    want_pin="$(cat "$tdir/pin" 2>/dev/null || printf '%s' "${EMU_P11_PIN:-$pin_default}")"
    tries="$(cat "$tdir/pin-tries" 2>/dev/null || echo 3)"
    if [ "$tries" -le 0 ]; then
      echo "error: PKCS11 function C_Login failed: rv = CKR_PIN_LOCKED (0xa4)" >&2; echo "Aborting." >&2; return 1
    fi
    if [ "${!var-}" != "$want_pin" ]; then
      echo $((tries - 1)) > "$tdir/pin-tries"
      echo "error: PKCS11 function C_Login failed: rv = CKR_PIN_INCORRECT (0xa0)" >&2; echo "Aborting." >&2; return 1
    fi
    echo 3 > "$tdir/pin-tries"
  fi
  if [ "$keygen" = 1 ]; then
    [ "$login" = 1 ] || { echo "error: keypairgen needs --login [EMULATED]" >&2; return 1; }
    mkdir -p "$kdir"
    case "$keytype" in
      EC:prime256v1|EC:secp384r1|EC:secp256k1) openssl ecparam -genkey -name "${keytype#EC:}" -noout -out "$kdir/key.pem" 2>/dev/null;;
      rsa:*) openssl genpkey -algorithm RSA -pkeyopt "rsa_keygen_bits:${keytype#rsa:}" -out "$kdir/key.pem" 2>/dev/null;;
      *) echo "error: unsupported key type $keytype [EMULATED]" >&2; return 1;;
    esac
    echo "Key pair generated [EMULATED]:"; return 0
  fi
  [ -f "$kdir/key.pem" ] || { echo "error: object with id $id not found [EMULATED]" >&2; echo "Aborting." >&2; return 1; }
  if [ "$read_obj" = 1 ]; then
    [ "$type" = pubkey ] && [ -n "$out" ] || { echo "error: only --type pubkey -o FILE is modelled" >&2; return 2; }
    openssl pkey -in "$kdir/key.pem" -pubout -outform DER -out "$out" 2>/dev/null; return
  fi
  if [ "$sign" = 1 ]; then
    [ "$login" = 1 ] || { echo "error: PKCS11 function C_Sign failed: rv = CKR_USER_NOT_LOGGED_IN (0x101)" >&2; return 1; }
    [ -f "$in" ] && [ -n "$out" ] || { echo "error: --sign needs --input-file and --output-file" >&2; return 2; }
    local data="$in"
    if [ "${EMU_P11_BAD_RESULT:-${EMU_P11_BAD_SIGNATURE:-0}}" = 1 ]; then
      data="$out.other"; { cat "$in"; printf 'x'; } | openssl dgst -sha256 -binary > "$data"
    fi
    echo "Using signature algorithm $mech"
    case "$mech" in
      ECDSA)
        openssl pkeyutl -sign -inkey "$kdir/key.pem" -in "$data" -out "$out.der" 2>/dev/null || return 1
        if [ "$fmt" = openssl ]; then mv "$out.der" "$out"
        else  # OpenSC's default: raw r||s, each padded to the field size
          python3 - "$out.der" "$out" "$(openssl pkey -in "$kdir/key.pem" -text -noout 2>/dev/null | sed -n 's/.*(\([0-9]*\) bit).*/\1/p' | head -1)" <<'PY'
import sys
d = open(sys.argv[1], "rb").read(); n = (int(sys.argv[3]) + 7) // 8
def tlv(b, i):
    l = b[i + 1]; i += 2
    if l & 0x80:
        k = l & 0x7f; l = int.from_bytes(b[i:i + k], "big"); i += k
    return b[i:i + l], i + l
body, _ = tlv(d, 0); r, i = tlv(body, 0); s, _ = tlv(body, i)
open(sys.argv[2], "wb").write(int.from_bytes(r, "big").to_bytes(n, "big") + int.from_bytes(s, "big").to_bytes(n, "big"))
PY
          rm -f "$out.der"
        fi ;;
      SHA256-RSA-PKCS) openssl dgst -sha256 -sign "$kdir/key.pem" -out "$out" "$data" 2>/dev/null || return 1 ;;
      *) echo "error: mechanism $mech not modelled [EMULATED]" >&2; return 1;;
    esac
    rm -f "$out.other"
    return 0
  fi
  local bad="${EMU_P11_BAD_RESULT:-${EMU_P11_BAD_SIGNATURE:-0}}"
  flip(){ python3 -c 'import sys; d=bytearray(open(sys.argv[1],"rb").read()); d[-1]^=1; open(sys.argv[1],"wb").write(d)' "$1"; }
  if [ "$decrypt" = 1 ] || [ "$derive" = 1 ]; then
    [ "$login" = 1 ] || { echo "error: PKCS11 function C_Login required: rv = CKR_USER_NOT_LOGGED_IN (0x101)" >&2; return 1; }
    [ -f "$in" ] && [ -n "$out" ] || { echo "error: needs --input-file and --output-file" >&2; return 2; }
  fi
  if [ "$decrypt" = 1 ]; then
    [ "$mech" = RSA-PKCS-OAEP ] || { echo "error: mechanism $mech not modelled for --decrypt [EMULATED]" >&2; return 1; }
    local md; md="$(printf '%s' "$oaep_hash" | tr 'A-Z' 'a-z' | tr -d '-')"
    local mgfmd; mgfmd="$(printf '%s' "${mgf:-MGF1-$oaep_hash}" | sed 's/^MGF1-//' | tr 'A-Z' 'a-z' | tr -d '-')"
    openssl pkeyutl -decrypt -inkey "$kdir/key.pem" -pkeyopt rsa_padding_mode:oaep -pkeyopt "rsa_oaep_md:$md" \
      -pkeyopt "rsa_mgf1_md:$mgfmd" -in "$in" -out "$out" 2>/dev/null \
      || { echo "error: PKCS11 function C_Decrypt failed: rv = CKR_ENCRYPTED_DATA_INVALID (0x40)" >&2; echo "Aborting." >&2; return 1; }
    [ "$bad" = 1 ] && flip "$out"
    return 0
  fi
  if [ "$derive" = 1 ]; then
    [ "$mech" = ECDH1-DERIVE ] || { echo "error: mechanism $mech not modelled for --derive [EMULATED]" >&2; return 1; }
    openssl pkeyutl -derive -inkey "$kdir/key.pem" -peerkey "$in" -peerform DER -out "$out" 2>/dev/null \
      || { echo "error: PKCS11 function C_DeriveKey failed: rv = CKR_MECHANISM_PARAM_INVALID (0x71)" >&2; echo "Aborting." >&2; return 1; }
    [ "$bad" = 1 ] && flip "$out"
    return 0
  fi
  echo "pkcs11-tool [EMULATED $emu_model]: nothing to do" >&2; return 2
}
if [ -n "$emu_model" ]; then
  if emu_p11 "$@"; then exit 0; else exit $?; fi
fi

REAL=""
# EMU_PKCS11_REAL lets the test harness point at a recorder/stub in place of the real
# OpenSC binary (mirrors sc-hsm-tool's EMU_SCHSM_REAL); ignored in normal operation.
for cand in "${EMU_PKCS11_REAL:-}" /usr/bin/pkcs11-tool /usr/local/bin/pkcs11-tool; do
  [ -n "$cand" ] && [ -x "$cand" ] && { REAL="$cand"; break; }
done
[ -n "$REAL" ] || { echo "pkcs11-tool: real OpenSC binary not found" >&2; exit 127; }

args=("$@")

have_module=0; have_pin=0; have_login=0
for a in "$@"; do
  case "$a" in
    --module) have_module=1 ;;
    --pin) have_pin=1 ;;
    --login|-l) have_login=1 ;;
  esac
done

inject=()
if [ "$have_module" -eq 0 ] && [ -n "${EMU_PKCS11_MODULE:-}" ]; then
  inject+=(--module "$EMU_PKCS11_MODULE")
fi
if [ "$have_login" -eq 1 ] && [ "$have_pin" -eq 0 ] && [ -n "${EMU_HSM_PIN:-}" ]; then
  # Pass the PIN off-argv: OpenSC pkcs11-tool resolves a `env:VAR` PIN value from the
  # environment, so only the literal reference `env:EMU_HSM_PIN` lands on the child's
  # command line — never the PIN itself (ps / /proc/<pid>/cmdline stay clean).
  export EMU_HSM_PIN
  inject+=(--pin "env:EMU_HSM_PIN")
fi

# Detect a pubkey export so we can normalise it to SubjectPublicKeyInfo afterwards: the
# real Nitrokey HSM 2 exports SPKI DER, but SoftHSM2 may emit a bare CKA_EC_POINT. The
# ceremony derives the address via the --der (SPKI) path ONLY, so emulating the card's
# SPKI output is what makes the real wizard path work unchanged.
is_pubkey=0; out_file=""; obj_id=""; keygen_label=""; is_list=0; is_keygen=0; prev=""
for a in "$@"; do
  case "$a" in
    --read-object)  is_pubkey_cmd=1 ;;
    --list-objects) is_list=1 ;;
    --keypairgen)   is_keygen=1 ;;
    pubkey)         want_pubkey=1 ;;
  esac
  [ "$prev" = "-o" ] && out_file="$a"
  [ "$prev" = "--id" ] && obj_id="$a"
  [ "$prev" = "--label" ] && keygen_label="$a"
  prev="$a"
done
[ "${is_pubkey_cmd:-0}" = 1 ] && [ "${want_pubkey:-0}" = 1 ] && [ -n "$out_file" ] && is_pubkey=1

STATE="${EMU_SCHSM_STATE:-/run/vault-emu/schsm}"
norm_id(){ local i="${1#"${1%%[!0]*}"}"; printf '%s' "${i:-0}"; }   # "02" -> "2", "01" -> "1"

# PER-DEVICE OBJECT MODEL. SoftHSM2 is ONE shared token, but the ceremony now drives TWO cards
# (primary + clone target), each modelled by its own $EMU_SCHSM_STATE directory. Enumerating the
# shared token for every "card" would make a blank clone target report the PRIMARY's funding key
# — the ceremony's blank-card guard would then refuse a genuinely blank device, and worse, a
# clone-target pubkey read could return the primary's key and pass a byte-compare that proves
# nothing. So: when a device's state dir EXISTS it is a modelled card and its objects registry is
# authoritative (an empty registry means a blank card). With no state dir we are not modelling a
# device at all and fall through to the real token, preserving the pre-two-device behaviour.
if [ "$is_list" = 1 ] && [ "${want_pubkey:-0}" = 1 ] && [ -d "$STATE" ]; then
  if [ -s "$STATE/objects" ]; then
    while IFS=: read -r ref lbl; do
      [ -n "$ref" ] || continue
      printf 'Public Key Object; EC\n  label:      %s\n  ID:         %s\n' "$lbl" "$ref"
    done < "$STATE/objects"
  fi
  exit 0
fi

# Restore-verify: the ceremony unwraps the DKEK backup into a scratch slot (key-reference 2) on a
# single card, or into key-reference 1 on a CLONE TARGET. sc-hsm-tool records which reference took
# the restore, so serve the reconstructed pubkey for exactly that slot — never by a hardcoded id,
# which on a clone target would let the read fall through to the shared SoftHSM token and hand back
# the PRIMARY card's key. A restored-pub.der only exists after a successful --unwrap-key, so a
# corrupt/unrestorable backup correctly yields a failed read here.
if [ "$is_pubkey" = 1 ] && [ -s "$STATE/restored.keyref" ]; then
  if [ "$(norm_id "$obj_id")" = "$(norm_id "$(cat "$STATE/restored.keyref")")" ]; then
    if [ -s "$STATE/restored-pub.der" ]; then cp "$STATE/restored-pub.der" "$out_file"; exit 0; fi
    exit 1
  fi
fi
# A modelled card can only export an object it actually holds; without a registry entry the read
# must FAIL rather than fall through to the shared token and borrow another card's key.
if [ "$is_pubkey" = 1 ] && [ -d "$STATE" ] && [ -n "$obj_id" ]; then
  if ! grep -q "^$(norm_id "$obj_id"):" "$STATE/objects" 2>/dev/null; then exit 1; fi
fi

if "$REAL" "${inject[@]}" "${args[@]}"; then status=0; else status=$?; fi

# Register a freshly generated keypair against THIS modelled device (see the per-device object
# model above) so a later --list-objects reports it and the ceremony's blank-card guard can
# refuse to --initialize over it. Without this a re-run would enumerate as blank and the guard
# would wave through a wipe of a non-exportable key.
if [ "$is_keygen" = 1 ] && [ "$status" = 0 ] && [ -d "$STATE" ]; then
  entry="$(norm_id "${obj_id:-1}"):${keygen_label:-akash-funding}"
  grep -qxF "$entry" "$STATE/objects" 2>/dev/null || printf '%s\n' "$entry" >> "$STATE/objects"
fi

if [ "$is_pubkey" = 1 ] && [ "$status" = 0 ] && [ -s "$out_file" ]; then
  python3 - "$out_file" <<'PY' 2>/dev/null || true
import sys
p = sys.argv[1]
der = open(p, "rb").read()
EC_PUB = bytes.fromhex("06072a8648ce3d0201")          # id-ecPublicKey
SECP256K1 = bytes.fromhex("06052b8104000a")           # secp256k1
# already a SubjectPublicKeyInfo with the EC OID? leave it alone.
if der[:1] == b"\x30" and EC_PUB in der and SECP256K1 in der:
    sys.exit(0)
# else extract the raw EC point (strip an OCTET STRING wrapper if present) ...
def tlv(b, i):
    t = b[i]; l = b[i+1]; i += 2
    if l & 0x80:
        n = l & 0x7f; l = int.from_bytes(b[i:i+n], "big"); i += n
    return t, b[i:i+l]
pt = der
try:
    t, v = tlv(der, 0)
    if t == 0x04:
        pt = v
except Exception:
    pass
if len(pt) >= 65 and pt[0] == 0x04:
    pt = pt[:65]
elif len(pt) >= 33 and pt[0] in (2, 3):
    pt = pt[:33]
else:
    sys.exit(0)   # unknown shape; leave original
# ... and wrap it as the canonical secp256k1 SubjectPublicKeyInfo the real card emits.
bitstr = b"\x03" + bytes([len(pt) + 1]) + b"\x00" + pt
algid = b"\x30\x10" + EC_PUB + SECP256K1
spki_body = algid + bitstr
spki = b"\x30" + bytes([len(spki_body)]) + spki_body
open(p, "wb").write(spki)
PY
fi
exit "$status"

#!/usr/bin/env bash
# ykman shim — emulates the YubiKey Manager CLI surface the ceremony touches (presence
# check, PIV info, touch-policy hints). No physical YubiKey, so this reports a plausible
# emulated YubiKey 5 so any `ykman …` route in a rehearsal runs without aborting.
#
# The age identity itself is handled by the age-plugin-yubikey shim (real age key); this
# only covers the management/inspection calls.
#
# PIV KEY GENERATION (regalia#28, the manifest-driven step). `--device SERIAL` selects one of any
# number of emulated tokens, each with its own state under $EMU_YKMAN_STATE/<serial>/<slot>/.
# `piv keys generate` makes a REAL key with openssl and records the algorithm and the policies it was
# asked for; `piv keys info` and `piv keys export` report them back in ykman 5.6's exact layout. So
# the evidence the wizard captures is a report of what was generated, with the same failure modes: a
# slot never generated is "No key stored", and a policy passed wrongly is reported wrongly.
# EMU_YKMAN_ORIGIN=IMPORTED makes the token claim an imported key, to prove the ceremony refuses it.
set -euo pipefail
SERIAL="${EMU_YKMAN_SERIAL:-12345678}"
STATE="${EMU_YKMAN_STATE:-${TMPDIR:-/tmp}/emu-ykman}"

if [ "${1:-}" = "--device" ] || [ "${1:-}" = "-d" ]; then
  SERIAL="${2:?--device needs a serial}"; shift 2
fi

slot_name(){
  case "$1" in
    9a) echo AUTHENTICATION;; 9c) echo SIGNATURE;; 9d) echo KEY_MANAGEMENT;; 9e) echo CARD_AUTH;;
    8[2-9]|9[0-5]) echo "RETIRED$(( 16#$1 - 16#81 ))";;
    *) echo "unknown slot $1" >&2; exit 2;;
  esac
}

piv_keys(){
  local verb="$1"; shift
  local alg=RSA2048 pin=DEFAULT touch=DEFAULT fmt=PEM args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -a|--algorithm) alg="$2"; shift 2;;
      --pin-policy) pin="$2"; shift 2;;
      --touch-policy) touch="$2"; shift 2;;
      -F|--format) fmt="$2"; shift 2;;
      -m|--management-key|-P|--pin) shift 2;;
      *) args+=("$1"); shift;;
    esac
  done
  local slot; slot="$(printf '%s' "${args[0]:?slot}" | tr 'A-F' 'a-f')"
  slot_name "$slot" >/dev/null
  local d="$STATE/$SERIAL/$slot"
  case "$verb" in
    generate)
      mkdir -p "$d"
      case "$alg" in
        ECCP256) openssl ecparam -genkey -name prime256v1 -noout -out "$d/key.pem" 2>/dev/null ;;
        ECCP384) openssl ecparam -genkey -name secp384r1 -noout -out "$d/key.pem" 2>/dev/null ;;
        RSA2048) openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$d/key.pem" 2>/dev/null ;;
        *) echo "Error: unsupported algorithm $alg [EMULATED]" >&2; exit 2 ;;
      esac
      printf '%s\n%s\n%s\n%s\n' "$alg" "$(printf '%s' "$pin" | tr a-z A-Z)" \
        "$(printf '%s' "$touch" | tr a-z A-Z)" "${EMU_YKMAN_ORIGIN:-GENERATED}" > "$d/meta"
      openssl pkey -in "$d/key.pem" -pubout -out "${args[1]:--}" ;;
    info|export)
      [ -f "$d/meta" ] || { echo "Error: No key stored in slot $slot." >&2; exit 1; }
      if [ "$verb" = info ]; then
        { read -r alg; read -r pin; read -r touch; read -r origin; } < "$d/meta"
        printf 'Key slot:               %s (%s)\n' "$(printf '%s' "$slot" | tr a-f A-F)" "$(slot_name "$slot")"
        printf 'Algorithm:              %s\nOrigin:                 %s\n' "$alg" "$origin"
        printf 'PIN required for use:   %s\nTouch required for use: %s\n' "$pin" "$touch"
      else
        openssl pkey -in "$d/key.pem" -pubout -outform "$fmt" -out "${args[1]:--}"
      fi ;;
    attest)
      # A Yubico-SHAPED attestation of the slot's key, issued under this emulator's own CA (emu_ca), with
      # Yubico's serial / policy / firmware extensions. ceremony-manifest trusts that CA only in a
      # simulation, via REGALIA_YUBICO_SIMULATED_TRUST_DIR=$STATE/trust.
      [ -f "$d/meta" ] || { echo "Error: No key stored in slot $slot." >&2; exit 1; }
      [ "$(sed -n 4p "$d/meta")" = GENERATED ] || { echo "Error: Attestation is only supported for generated keys." >&2; exit 1; }
      emu_ca
      local pin touch pinb touchb hexserial
      pin="$(sed -n 2p "$d/meta")"; touch="$(sed -n 3p "$d/meta")"
      case "$pin" in NEVER) pinb=01;; ALWAYS) pinb=03;; *) pinb=02;; esac        # ONCE (and DEFAULT) = 02
      case "$touch" in ALWAYS) touchb=02;; CACHED) touchb=03;; *) touchb=01;; esac # NEVER (and DEFAULT) = 01
      hexserial="$(printf '%08x' "$SERIAL" | sed 's/../&:/g; s/:$//')"
      openssl pkey -in "$d/key.pem" -pubout -out "$d/pub.pem" 2>/dev/null
      printf 'basicConstraints=critical,CA:FALSE\n1.3.6.1.4.1.41482.3.7=DER:02:04:%s\n1.3.6.1.4.1.41482.3.8=DER:%s:%s\n1.3.6.1.4.1.41482.3.3=DER:05:07:04\n' \
        "$hexserial" "$pinb" "$touchb" > "$d/att.ext"
      openssl req -new -key "$STATE/ca/f9.key" -subj "/CN=YubiKey PIV Attestation $slot" -out "$d/att.csr" 2>/dev/null
      openssl x509 -req -in "$d/att.csr" -force_pubkey "$d/pub.pem" -CA "$STATE/ca/f9.pem" -CAkey "$STATE/ca/f9.key" \
        -set_serial "0x$(openssl rand -hex 8)" -days 3650 -extfile "$d/att.ext" -out "${args[1]:--}" 2>/dev/null ;;
    *) echo "[EMULATED] ykman piv keys $verb $*" ;;
  esac
}

# The emulator's attestation CA: root -> "PIV attestation" intermediate -> f9, created once per $STATE.
# $STATE/trust holds roots.pem and intermediates.pem for REGALIA_YUBICO_SIMULATED_TRUST_DIR. Like the
# real batch key, one f9 serves every emulated serial; the signed serial extension is what differs.
emu_ca(){
  local ca="$STATE/ca"
  [ -f "$ca/f9.pem" ] && return 0
  mkdir -p "$ca" "$STATE/trust"
  printf 'basicConstraints=critical,CA:TRUE\n' > "$ca/ca.ext"
  openssl ecparam -genkey -name prime256v1 -noout -out "$ca/root.key" 2>/dev/null
  openssl req -new -x509 -key "$ca/root.key" -subj "/CN=Emulated Yubico Attestation Root" -days 3650 \
    -addext "basicConstraints=critical,CA:TRUE" -out "$ca/root.pem" 2>/dev/null
  local name
  for name in inter f9; do
    openssl ecparam -genkey -name prime256v1 -noout -out "$ca/$name.key" 2>/dev/null
  done
  openssl req -new -key "$ca/inter.key" -subj "/CN=Emulated PIV Attestation" -out "$ca/inter.csr" 2>/dev/null
  openssl x509 -req -in "$ca/inter.csr" -CA "$ca/root.pem" -CAkey "$ca/root.key" -set_serial 2 -days 3650 \
    -extfile "$ca/ca.ext" -out "$ca/inter.pem" 2>/dev/null
  openssl req -new -key "$ca/f9.key" -subj "/CN=YubiKey PIV Attestation" -out "$ca/f9.csr" 2>/dev/null
  openssl x509 -req -in "$ca/f9.csr" -CA "$ca/inter.pem" -CAkey "$ca/inter.key" -set_serial 3 -days 3650 \
    -extfile "$ca/ca.ext" -out "$ca/f9.pem" 2>/dev/null
  cp "$ca/root.pem" "$STATE/trust/roots.pem"
  cp "$ca/inter.pem" "$STATE/trust/intermediates.pem"
}

case "${1:-}" in
  list|"--version")
    [ "${1:-}" = "--version" ] && { echo "YubiKey Manager (ykman) 5.5.1 [EMULATED]"; exit 0; }
    echo "YubiKey 5 NFC (5.4.3) [Emulated] Serial: $SERIAL" ;;
  info)
    cat <<EOF
Device type: YubiKey 5 NFC [EMULATED]
Serial number: $SERIAL
Firmware version: 5.4.3
Applications: OTP, FIDO2, PIV, OpenPGP
EOF
    ;;
  piv)
    case "${2:-}" in
      info)
        cat <<EOF
PIV version: 5.4.3 [EMULATED]
PIN tries remaining: ${EMU_YKMAN_PIV_RETRIES:-3}
Slot 9a (AUTHENTICATION): occupied (P-256, touch policy: ALWAYS)
EOF
        ;;
      keys)
        piv_keys "${3:-}" "${@:4}" ;;
      certificates)
        if [ "${3:-}" = export ] && [ "$(printf '%s' "${4:-}" | tr 'A-F' 'a-f')" = f9 ]; then
          emu_ca; cp "$STATE/ca/f9.pem" "${5:?output file}"
        else
          echo "[EMULATED] ykman piv ${*:2}"
        fi ;;
      *) echo "[EMULATED] ykman piv ${*:2}" ;;
    esac
    ;;
  *)
    echo "[EMULATED] ykman $* (no-op)" ;;
esac

#!/usr/bin/env python3
"""sle4442-manager — drive an SLE-4442 memory card over PC/SC.

This is a real ceremony-style route: a PC/SC application that stores / retrieves a small
secret payload (e.g. a Shamir share, a PIN, or a recovery pointer) on an SLE-4442 memory
card, using the standard PC/SC memory-card pseudo-APDUs (CLA=0xFF). Against the emulator
it talks to sle4442-vpicc.py through pcscd + vpcd; against a real Identiv/SCM reader with
a real SLE-4442 it works unchanged.

  sle4442-manager info                       # picks the one reader holding an SLE-4442 (by ATR)
  sle4442-manager verify  --psc FFFFFF
  sle4442-manager read    --addr 32 --len 16
  sle4442-manager write   --psc FFFFFF --addr 32 --hex-file share.hex
  SLE4442_PSC=... SLE4442_TEXT="share-1-..." sle4442-manager store --addr 32   # share off argv

The PSC *and* the secret payload (--text/--hex) resolve off the command line: prefer the
SLE4442_PSC / SLE4442_TEXT / SLE4442_HEX env vars or the --psc-file/--text-file/--hex-file
inputs. Passing any of them directly on argv warns, because argv is visible in `ps` /
`/proc/<pid>/cmdline` / shell history.
"""
import argparse
import os
import sys

try:
    from smartcard.System import readers
    from smartcard.util import toBytes, toHexString
except Exception as exc:  # pragma: no cover - only in the emulator image
    sys.exit(f"sle4442-manager: pyscard not available ({exc}); run inside the emulator image")


# SLE-4442 answers to reset with the ISO 7816-10 synchronous ATR A2 13 10 91; readers that hide
# the 2-wire protocol behind PC/SC synthesise a 3B 04 header around the same identity bytes
# (e.g. ACS: 3B 04 92 23 10 91). A token (Nitrokey, YubiKey) never carries either.
_SLE4442_ATR_MARKS = (bytes.fromhex("a2131091"), bytes.fromhex("92231091"))


def _looks_sle4442(reader):
    try:
        conn = reader.createConnection()
        conn.connect()
        atr = bytes(conn.getATR())
        conn.disconnect()
    except Exception:
        return False
    return any(m in atr for m in _SLE4442_ATR_MARKS)


def _connect(reader_substr):
    rl = readers()
    if not rl:
        sys.exit("no PC/SC readers found — is pcscd + vpcd + the vpicc running?")
    if reader_substr is not None:
        matches = [r for r in rl if reader_substr.lower() in str(r).lower()]
        if not matches:
            sys.exit(f"no reader matching '{reader_substr}'. readers: {[str(r) for r in rl]}")
        chosen = matches[0]
    else:
        # NEVER "the first reader". On the vault the first reader can be a Nitrokey or a YubiKey,
        # and a PSC sent there is at best a confusing failure. Pick the one reader holding an
        # SLE-4442 card, or refuse and name the readers.
        cards = [r for r in rl if _looks_sle4442(r)]
        if len(cards) != 1:
            sys.exit("%s SLE-4442 card found by ATR; name the reader with --reader or "
                     "SLE4442_READER (a substring of one of: %s)"
                     % ("no" if not cards else "more than one", [str(r) for r in rl]))
        chosen = cards[0]
    conn = chosen.createConnection()
    try:
        conn.connect()
    except Exception as exc:
        # A card that is present but mute is the signature of a reader without synchronous
        # memory-card support (seen with a Realtek 0bda:0169 combo reader, regalia#43), or a card
        # inserted the wrong way round.
        sys.exit(f"the card in '{chosen}' does not answer ({exc}). Check it is inserted chip-up; if "
                 "it still does not answer, this reader cannot drive SLE-4442 memory cards.")
    return conn, str(chosen)


def _xmit(conn, apdu_hex):
    data, sw1, sw2 = conn.transmit(toBytes(apdu_hex))
    return data, sw1, sw2


def _ok(sw1, sw2):
    return sw1 == 0x90 and sw2 == 0x00


def select_sle4442(conn):
    _, sw1, sw2 = _xmit(conn, "FF A4 00 00 01 06")
    if not _ok(sw1, sw2):
        sys.exit(f"SELECT SLE4442 failed: {sw1:02X} {sw2:02X}")


def cmd_info(conn):
    select_sle4442(conn)
    sec, s1, s2 = _xmit(conn, "FF B1 00 00 04")
    prot, p1, p2 = _xmit(conn, "FF B2 00 00 04")
    attempts = bin(sec[0] & 0x07).count("1") if _ok(s1, s2) else "?"
    # NOTE: deliberately does NOT print main-memory contents — the card may hold a secret
    # (a Shamir share). `info` shows only non-secret status (counter + protection map). Use
    # the explicit `read` subcommand if you really intend to display stored bytes.
    print(f"card: SLE4442 (emulated or real)")
    print(f"  error counter   : {sec[0]:#04x}  ({attempts} PSC attempts left)")
    print(f"  protection bits : {toHexString(prot)}")
    print(f"  memory          : 256 bytes (contents not shown; use `read` to display)")


# Bytes 0..31 are the card's factory area: the first four are the header the card answers reset
# with (A2 13 10 91), the rest manufacturer data, and cards usually ship with them write-protected
# (the only range protection memory covers). A share never goes there.
FIRST_USER_BYTE = 32


def _present_psc(conn, psc):
    """Present the PSC. Returns None when verified, else exits with the reason.

    ACS ACR39x Reference Manual v1.03, 8.4.7: SW1 = 90h and SW2 is the error counter — 07h
    verified, 00h LOCKED, anything else this presentation failed. So 90 00 means LOCKED here; a
    tool that took 90 00 as success would report a locked card as unlocked."""
    _, sw1, sw2 = _xmit(conn, "FF 20 00 00 03 " + psc)
    # Exact values only: SW2 is a 3-bit counter, so anything above 07 is not a documented answer
    # and must never be read as success (masking would turn 90 0F into "verified").
    if sw1 != 0x90 or sw2 > 0x07:
        sys.exit(f"PSC presentation failed: {sw1:02X} {sw2:02X}")
    if sw2 == 0x07:
        return None
    if sw2 == 0x00:
        sys.exit("the card is LOCKED (PSC error counter 0): it can never be written again")
    sys.exit(f"PSC wrong — {bin(sw2).count('1')} attempt(s) left")


def _read(conn, addr, length):
    """Read `length` bytes. ACS appends PROT 1..4 (the protection bits) after the data (8.4.2);
    other readers may not. Return exactly the data, or exit if the length is neither."""
    data, sw1, sw2 = _xmit(conn, f"FF B0 00 {addr:02X} {length:02X}")
    if not _ok(sw1, sw2):
        sys.exit(f"read failed: {sw1:02X} {sw2:02X}")
    if len(data) == length + 4:
        data = data[:length]
    elif len(data) != length:
        sys.exit(f"read returned {len(data)} bytes for {length} requested")
    return bytes(data)


def cmd_verify(conn, psc):
    select_sle4442(conn)
    _present_psc(conn, psc)
    print("PSC verified — card unlocked for writing")


def cmd_read(conn, addr, length):
    select_sle4442(conn)
    print(_read(conn, addr, length).hex().upper())


def _check_range(addr, length):
    """Refuse before anything reaches the card, so a refused write spends no PSC attempt."""
    if addr < FIRST_USER_BYTE:
        sys.exit(f"refusing to write at {addr}: bytes 0..{FIRST_USER_BYTE - 1} are the card's factory "
                 f"area (its reset header and manufacturer data). Use --addr {FIRST_USER_BYTE} or later.")
    if addr + length > 256:
        sys.exit("payload too large for the card at that address")


def _write(conn, psc, addr, payload):
    _check_range(addr, len(payload))
    select_sle4442(conn)
    _present_psc(conn, psc)
    hexpayload = " ".join(f"{b:02X}" for b in payload)
    apdu = f"FF D0 00 {addr:02X} {len(payload):02X} " + hexpayload
    _, w1, w2 = _xmit(conn, apdu)
    if not _ok(w1, w2):
        sys.exit(f"write failed: {w1:02X} {w2:02X}")


def cmd_write(conn, psc, addr, hexdata):
    payload = bytes.fromhex(hexdata)
    _write(conn, psc, addr, payload)
    # verify-read back: a card can ACK the UPDATE (SW=90 00) yet persist zeros/garbage (a
    # weak/faulty EEPROM cell or a hostile card). For a set-once key backup, never report
    # success on the status word alone — read the bytes back and fail loudly on any mismatch.
    if _read(conn, addr, len(payload)) != payload:
        # never echo `payload` — it is the secret share; report only non-secret status
        sys.exit(f"verify-read mismatch after write at {addr}: the card did not persist the payload")
    print(f"wrote and verified {len(payload)} bytes at {addr}")


def cmd_store(conn, psc, addr, text):
    payload = text.encode()
    # The share is stored with no length field, so the WHOLE area to the end of the card is
    # written: the text, then 00 padding. Otherwise a shorter share over a longer earlier one
    # leaves the old tail behind, and a recoverer reading to the end gets the wrong words even
    # though this store verified. Text cannot contain 00 or FF, so padding is unambiguous.
    if b"\x00" in payload or b"\xff" in payload:
        sys.exit("refusing to store: the text contains a 00 or FF byte, which recovery strips")
    _check_range(addr, len(payload))
    area = payload + b"\x00" * (256 - addr - len(payload))
    _write(conn, psc, addr, area)
    # verify-read back the whole area, padding included
    if _read(conn, addr, len(area)) != area:
        sys.exit("verify-read mismatch after store")
    # NOTE: never echo `text` — it is the secret payload (e.g. a Shamir share). Print only
    # non-secret status so a tee/script log or screenshot of the ceremony can't leak it.
    print(f"stored and verified {len(payload)} bytes at {addr}")


DEFAULT_PSC = "FFFFFF"   # the factory PSC — public, not a secret


def resolve_psc(args):
    """Resolve the PSC without exposing a real one on the command line. Order:
       SLE4442_PSC env  >  --psc-file <path>  >  --psc <hex>. A non-default PSC passed on
       argv warns, because it would be visible in `ps` / /proc/<pid>/cmdline / shell history."""
    env = os.environ.get("SLE4442_PSC")
    if env:
        return env.strip()
    pf = getattr(args, "psc_file", None)
    if pf:
        with open(pf) as fh:
            return fh.read().strip()
    psc = getattr(args, "psc", None)
    if psc and psc.upper() != DEFAULT_PSC:
        sys.stderr.write("WARNING: a non-default PSC was passed on the command line — it is "
                         "visible in `ps`/shell history. Use SLE4442_PSC env or --psc-file.\n")
    return psc or DEFAULT_PSC


def resolve_secret(args, kind):
    """Resolve the secret payload (the share/seed itself) WITHOUT exposing it on the command
    line — the same protection resolve_psc gives the far-less-sensitive PSC. Order:
       SLE4442_<KIND> env  >  --<kind>-file <path>  >  --<kind> <value>.
    A payload passed directly on argv warns, because it is visible in `ps` /
    `/proc/<pid>/cmdline` / shell history; the warning never echoes the value itself. `kind`
    is "text" (store) or "hex" (write). env/file inputs are whitespace-stripped (an editor's
    trailing newline is not part of the share); an argv value is returned verbatim."""
    upper = kind.upper()
    env = os.environ.get(f"SLE4442_{upper}")
    if env is not None:
        return env.strip()
    pf = getattr(args, f"{kind}_file", None)
    if pf:
        with open(pf) as fh:
            return fh.read().strip()
    val = getattr(args, kind, None)
    if val is None:
        sys.exit(f"no secret payload: pass SLE4442_{upper} env, --{kind}-file <path>, or "
                 f"--{kind} <value>")
    sys.stderr.write(f"WARNING: the secret payload was passed via --{kind} on the command line "
                     f"— it is visible in `ps`/`/proc/<pid>/cmdline`/shell history. Prefer "
                     f"SLE4442_{upper} env or --{kind}-file to keep it off argv.\n")
    return val


def main(argv=None):
    ap = argparse.ArgumentParser(description="drive an SLE-4442 card over PC/SC")
    ap.add_argument("--reader", default=os.environ.get("SLE4442_READER") or None,
                    help="reader name substring (default: SLE4442_READER, else the one reader "
                         "holding an SLE-4442 card by ATR)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("info")
    for name_ in ("verify", "write", "store"):
        sp = sub.add_parser(name_)
        sp.add_argument("--psc", default=None,
                        help="PSC hex (PREFER SLE4442_PSC env or --psc-file to keep it off argv)")
        sp.add_argument("--psc-file", default=None, help="read the PSC from this file (not argv)")
        if name_ in ("write", "store"):
            sp.add_argument("--addr", type=int, required=True)
        if name_ == "verify":
            pass
        if name_ == "write":
            sp.add_argument("--hex", default=None,
                            help="hex payload (PREFER SLE4442_HEX env or --hex-file to keep it off argv)")
            sp.add_argument("--hex-file", default=None,
                            help="read the hex payload from this file (not argv)")
        if name_ == "store":
            sp.add_argument("--text", default=None,
                            help="secret text payload (PREFER SLE4442_TEXT env or --text-file to keep it off argv)")
            sp.add_argument("--text-file", default=None,
                            help="read the secret text payload from this file (not argv)")
    p = sub.add_parser("read");   p.add_argument("--addr", type=int, required=True); p.add_argument("--len", type=int, required=True)
    args = ap.parse_args(argv)

    conn, name = _connect(args.reader)
    try:
        if args.cmd == "info":
            cmd_info(conn)
        elif args.cmd == "verify":
            cmd_verify(conn, resolve_psc(args))
        elif args.cmd == "read":
            cmd_read(conn, args.addr, args.len)
        elif args.cmd == "write":
            cmd_write(conn, resolve_psc(args), args.addr, resolve_secret(args, "hex"))
        elif args.cmd == "store":
            cmd_store(conn, resolve_psc(args), args.addr, resolve_secret(args, "text"))
    finally:
        try:
            conn.disconnect()
        except Exception:
            pass


if __name__ == "__main__":
    main()
